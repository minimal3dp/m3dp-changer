# COMMISSIONING DRAFT: copy this as the MAIN printer.cfg after completing the
# required hardware/hotend/motor settings. Leave TAP/dock gates disabled until
# their physical checks are complete; see README.md for the commissioning order.
# This preserves the supplied Voron motion and CAN setup; original files stay intact.
# Bed SSR must move physically from HE1/PB5 to BED/PB7; disconnect case lighting
# from HE2/PB6 before the four external heater-control inputs are connected.
# Preserve the relative ../voron include layout when installing.

[include ../voron/mainsail.cfg]
[include ../voron/KNOMI.cfg]
[include ../voron/klipper_backup.cfg]
# Legacy macros.cfg is not loaded: PRINT_START/END are replaced below, and
# its PARK/G32 helpers can descend to a fixed Z30 across an existing print.
[include nevermore.cfg]
[include ../voron/stealthburner_leds.cfg]
#[include klipper_macros.cfg]
[skew_correction]

[save_variables]
filename: ~/printer_data/config/variables.cfg

[mcu]
canbus_uuid: 20a6cbafd015
#restart_method: command

[mcu EBBCan]
canbus_uuid: f2c8dad996fc

[printer]
kinematics: corexy
max_velocity: 700
max_accel: 4500  # should not exceed the estimated max_accel for X and Y axes	
max_z_velocity: 25 			
max_z_accel: 350
square_corner_velocity: 5.0

# M8P temperature
[temperature_sensor MCU]
sensor_type: temperature_mcu
min_temp: 0
max_temp: 100

# CB1 Temp
[temperature_sensor CB1]
sensor_type: temperature_host
min_temp: 0
max_temp: 100

###################################
#	X/Y Stepper Settings
###################################

# X Stepper on Motor1(B Motor)
# M1

[stepper_x]
step_pin: PE2
dir_pin: PB4
enable_pin: !PC11
microsteps: 32
rotation_distance: 40
full_steps_per_rotation:200
endstop_pin: ^EBBCan: gpio24
position_endstop: 350
position_max: 350
homing_speed: 25   #Max 100
homing_retract_dist: 5
homing_positive_dir: true

[tmc2209 stepper_x]
uart_pin: PC10
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

# Y Stepper on Motor2 (A Motor)
# M2

[stepper_y]
step_pin: PF12
dir_pin: PF11
enable_pin: !PB3
microsteps: 32
rotation_distance: 40
endstop_pin: ^PF4
full_steps_per_rotation:200  #set to 400 for 0.9 degree stepper
position_min: 0
position_endstop: 350
position_max: 350
homing_speed: 25  #Max 100
homing_retract_dist: 5
homing_positive_dir: true

[tmc2209 stepper_y]
uart_pin: PF13
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

###################################
#	Z Stepper Settings
###################################

# Z0 Stepper - Front Left on MOTOR3_A
# M3

[stepper_z]
step_pin: PD7
dir_pin: PD6
enable_pin: !PF10
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32
#endstop_pin: ^PF5
endstop_pin: probe: z_virtual_endstop
position_max: 310
position_min: -5
homing_speed: 8
second_homing_speed: 3
homing_retract_dist: 3

[tmc2209 stepper_z]
uart_pin: PF9
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

# Z1 Stepper - Rear Left on Motor5
# M5

[stepper_z1]
step_pin: PC9
dir_pin: !PC8
enable_pin: !PD1
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc2209 stepper_z1]
uart_pin: PD0
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

# Z2 Stepper - Rear Right on Motor6
# M6

[stepper_z2]
step_pin: PA10
dir_pin: PA14
enable_pin: !PA15
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc2209 stepper_z2]
uart_pin: PF8
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

# Z3 Stepper - Front Right on Motor7
# M7

[stepper_z3]
step_pin: PD11
dir_pin: !PD9
enable_pin: !PD15
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc2209 stepper_z3]
uart_pin: PD14
interpolate: false
run_current: 0.8
sense_resistor: 0.110
stealthchop_threshold: 0

###################################
#	Extruder
###################################

# The shared motor stays on the verified SB2209 RP2040 driver. Confirm the
# HGX-LITE motor, tooth ratio, direction and feed calibration before enabling it.
# The previous 50:10 / 22.979 calibration belongs to the old extruder.
[extruder]
step_pin: EBBCan: gpio18
dir_pin: EBBCan: gpio19
enable_pin: !EBBCan: gpio17
microsteps: 32
gear_ratio: REPLACE_WITH_VERIFIED_HGX_GEAR_RATIO
full_steps_per_rotation: REPLACE_WITH_VERIFIED_MOTOR_STEPS
rotation_distance: REPLACE_WITH_CALIBRATED_HGX_ROTATION_DISTANCE
nozzle_diameter: 0.400
filament_diameter: 1.750
max_extrude_only_distance: 101
# All thermal options now come from hotends.cfg; the old SB2209 heater and
# thermistor outputs are not configured as a second copy of T0.

[tmc2209 extruder]
uart_pin: EBBCan: gpio20
# Old motor used 0.65 A. Verify the installed HGX motor rating before selecting RMS current.
run_current: REPLACE_WITH_VERIFIED_HGX_MOTOR_CURRENT
interpolate: false
sense_resistor: 0.110
stealthchop_threshold: 0

###################################
#	Bed Heater
###################################

[heater_bed]
# SSR input moved physically from HE1 to dedicated BED output.
# Confirm M8P V1.1 BED_POWER/SSR input wiring before any heating command.
heater_pin: PB7
# Check what thermistor type you have. See https://www.klipper3d.org/Config_Reference.html#common-thermistors for common thermistor types.
# Use "Generic 3950" for NTC 100k 3950 thermistors
sensor_type: Generic 3950
sensor_pin: PA0
max_power: 0.80 # Adjust Max Power according to 0.4w per square cm. Calculator available at https://tools.takuya.wtf/
min_temp: 0
max_temp: 120
#control: pid
#pid_kp: 38.035
#pid_ki: 1.761
#pid_kd: 205.388

###################################
#	Extruder / Tool Head / Tool Head Fans
###################################

[temperature_sensor EBB_NTC]
sensor_type: Generic 3950
sensor_pin: EBBCan:gpio28

[adxl345]
cs_pin: EBBCan:gpio1
spi_software_sclk_pin: EBBCan:gpio2
spi_software_mosi_pin: EBBCan:gpio0
spi_software_miso_pin: EBBCan:gpio3
axes_map: z,-y,x

[resonance_tester]
# Somewhere slightly above the middle of your print bed
probe_points: 175, 175, 50
accel_chip: adxl345

# Inherited values only: repeat resonance calibration for the new head mass.
[input_shaper]
shaper_freq_x: 90.6
shaper_type_x: 3hump_ei
shaper_freq_y: 71.6
shaper_type_y: 3hump_ei

[fan]
pin: EBBCan:gpio13

# Existing GPIO14 head cooling is defined in hardware.cfg and watches all six heaters.

###################################
#	Electronics Compartment Fan Control
###################################

[controller_fan Electronics_Fan]
# Controller fan - CNC_FAN0
# Fan0
# Fans to cool the electronics compartment
pin: PE6
max_power: 1.0
off_below: 0.25
kick_start_time: 1.0
fan_speed: 0.8
shutdown_speed: 1.0
heater: heater_bed, extruder, extruder1, extruder2, extruder3, extruder4, extruder5
stepper: stepper_x, stepper_y, stepper_z
idle_timeout: 120

[controller_fan Electronics_Fan1]
# Controller fan - CNC_FAN1
# Fan1
# Fans to cool the electronics compartment
pin: PE0
max_power: 1.0
off_below: 0.25
kick_start_time: 1.0
fan_speed: 0.8
shutdown_speed: 1.0
heater: heater_bed, extruder, extruder1, extruder2, extruder3, extruder4, extruder5
stepper: stepper_x, stepper_y, stepper_z
idle_timeout: 120

###################################
#	Exhaust Fan Control
###################################

[heater_fan exhaust_fan]
##	Exhaust fan - CNC_FAN2
pin: PC12
max_power: 1.0
shutdown_speed: 0.0
kick_start_time: 5.0
heater: heater_bed
heater_temp: 60
fan_speed: 1.0

###################################
#	Tap Probe
###################################

# TAP pin and sampling settings are retained in tap.cfg with T0 guards.
# Recalibrate the inherited probe Z offset after assembling the new head.

[bed_mesh]
speed: 400
horizontal_move_z: 3
mesh_min: 10,10
mesh_max: 340,340
probe_count: 5,5
algorithm: bicubic
bicubic_tension: 0.2


#####################################################################
# 	LED Control
#####################################################################

# DISABLED: HE2/PB6 is now the T2 external heater-switch control.
# Physically disconnect case lighting here; do not enable until rewired to a
# verified, suitably rated unused output.
# [output_pin caselight]
# # Chamber Lighting - HE2 Connector (Optional)
# pin: PB6
# pwm:true
# shutdown_value: 0
# value:1
# cycle_time: 0.01

###################################
# 	Filament Sensor 
#   https://github.com/Zev-se/voron_2.4_config/blob/main/printer_data/config/Voron2_Octopus_Config.cfg
###################################

#[filament_switch_sensor filament_sensor]
#switch_pin: EBBCan: gpio21
#pause_on_runout: false
#runout_gcode: M600

###################################
# 	Homing and Gantry Adjustment Routines
###################################

[idle_timeout]
timeout: 1800

[safe_z_home]
home_xy_position:175,175
speed:100
z_hop:10

[quad_gantry_level]
gantry_corners:
	-60,-10
	410,420
# Probe points
points:
	25,25
	25,325
	325,325
	325,25
speed: 250
horizontal_move_z: 10
retries: 5
retry_tolerance: 0.0125
max_adjust: 10

[board_pins]
aliases:
    # EXP1 header
    EXP1_1=PE9, EXP1_2=PE10,
    EXP1_3=PE11, EXP1_4=PE12,
    EXP1_5=PE13, EXP1_6=PE14,    # Slot in the socket on this side
    EXP1_7=PE15, EXP1_8=PB10,
    EXP1_9=<GND>, EXP1_10=<5V>,

    # EXP2 header
    EXP2_1=PB14, EXP2_2=PB13,
    EXP2_3=PF7, EXP2_4=PB12,
    EXP2_5=PE7, EXP2_6=PB11,      # Slot in the socket on this side
    EXP2_7=PE8, EXP2_8=<RST>,
    EXP2_9=<GND>, EXP2_10=<NC>

#####################################################################
# 	MISC
#####################################################################

# Enable object exclusion
[exclude_object]

# Enable arcs support
[gcode_arcs]
resolution: 0.3

[force_move]
enable_force_move: True

# Inherited values only: repeat resonance calibration for the new head mass.
[input_shaper]
shaper_freq_x: 90.4
shaper_type_x: 3hump_ei
shaper_freq_y: 39
shaper_type_y: mzv

# Load toolchanger wrappers last so they replace the old startup/pause and
# KNOMI homing macro bodies while preserving the peripheral definitions.
[include cxchanger.cfg]

